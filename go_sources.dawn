cache = Cache()
package_cache = Cache()

fields = ",".join([
	"ImportPath",
	"Imports",
	"TestImports",
	"XTestImports",
	"Dir",
	"GoFiles",
	"CgoFiles",
	"CompiledGoFiles",
	"CFiles",
	"CXXFiles",
	"MFiles",
	"HFiles",
	"FFiles",
	"SFiles",
	"SwigFiles",
	"SwigCXXFiles",
	"SysoFiles",
	"TestGoFiles",
	"XTestGoFiles",
	"EmbedFiles",
	"TestEmbedFiles",
	"XTestEmbedFiles",
])

def go_sources(package_dir=None, tags=None, env=None):
    """
    Returns the project-local sources used to build the package tree rooted at package_dir.

    :param package_dir: the directory of the root package.
    :param tags: build tags to pass to `go list`.
    :param env: build environment variables that affect `go list`.
    """

    tags = tags or []
    env = env or {}
    tags_flag = f"-tags='{','.join(tags)}'" if tags else ""
    env_key = f"{[(key, env[key]) for key in sorted(env)]}"
    cache_key = f"{env_key}|{tags_flag}"
    packages = {}
    visited = set()
    sources = []

    def visit_package(import_path):
        if import_path in visited or import_path not in packages:
            return
        visited.add(import_path)

        p = packages[import_path]
        for imports in ["Imports", "TestImports", "XTestImports"]:
            if imports in p:
                for import_path in p[imports]:
                    visit_package(import_path)

        (package_dir, ok) = contains(p["Dir"])
        if not ok:
            return

        def find_package_sources():
            package_sources = []

            def add_files(kind):
                if kind in p:
                    for path in p[kind]:
                        if not os.path.is_abs(path):
                            path = os.path.join(p["Dir"], path)
                        (source, ok) = contains(path)
                        if ok:
                            package_sources.append(source)

            add_files("GoFiles")
            add_files("CgoFiles")
            add_files("CompiledGoFiles")
            add_files("CFiles")
            add_files("CXXFiles")
            add_files("MFiles")
            add_files("HFiles")
            add_files("FFiles")
            add_files("SFiles")
            add_files("SwigFiles")
            add_files("SwigCXXFiles")
            add_files("SysoFiles")
            add_files("TestGoFiles")
            add_files("XTestGoFiles")
            add_files("EmbedFiles")
            add_files("TestEmbedFiles")
            add_files("XTestEmbedFiles")
            return package_sources

        package_sources = package_cache.once(f"{cache_key}|{package_dir}", find_package_sources)
        for source in package_sources:
            sources.append(source)

    def list_packages(root):
        return json.decode_all(sh.output(f"go list {tags_flag} -json={fields} -test -deps ./...", cwd=root, env=env))

    def find_sources(package_list):
        for p in package_list:
            packages[p["ImportPath"]] = p
        for import_path in packages:
            visit_package(import_path)

    package_dir = os.path.abs(package_dir or ".")
    def find_all_sources():
        mod = json.decode(sh.output("go list -m -json", cwd=package_dir, env=env))
        if mod["Path"] != "command-line-arguments":
            (source, ok) = contains(mod["GoMod"])
            if ok:
                sources.append(source)

        find_sources(list_packages(package_dir))
        return sources

    return cache.once(f"{cache_key}|{package_dir}", find_all_sources)
